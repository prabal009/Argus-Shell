# ============================================================
# Argus runtime data (NEVER commit these)
# ============================================================

# SQLite databases (audit log, suspicious events, security actions)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Argus data directory (if someone copies it into the repo)
.argus/

# Policy file — may contain a personal allowlist/denylist
policy.json

# Readline history — contains every command you ever typed
.argus_history
*_history


